# REQUIRED: encrypts stored tokens and API keys. Generate with: openssl rand -base64 32
# Keep this value safe. If you lose it, stored credentials can't be decrypted.
MASTER_KEY=

# Postgres connection. If you leave it unset, an embedded database (PGlite) is stored under DATA_DIR.
# docker-compose.yml sets this automatically.
# DATABASE_URL=postgres://user:pass@host:5432/prai

# Lets other people create accounts after the first (admin) user. Default: false.
ALLOW_REGISTRATION=false

# Set to true when serving over HTTPS, so the session cookie is only sent over TLS.
COOKIE_SECURE=false

# AI request tuning
AI_TIMEOUT_MS=300000
# Parallel model requests per review. Keep 1-2 for a single local GPU.
AI_CONCURRENCY=2

# Background jobs. Reviews run on a queue stored in the database; each server process runs a worker.
# JOB_CONCURRENCY=2
# JOB_WORKER=off   (for a process that should only serve the UI and API)

# Address people, code hosts and identity providers use to reach the app:
# used for webhook URLs, SSO redirect URIs and GitHub App / Entra callbacks.
# PUBLIC_URL=https://pr-review.example.com

# Corporate networks
# HTTPS_PROXY=http://proxy.corp:8080
# NO_PROXY=localhost,db,ollama
# NODE_EXTRA_CA_CERTS=/certs/corp-ca.pem   (mount the file into the container)
